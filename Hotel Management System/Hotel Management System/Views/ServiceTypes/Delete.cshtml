@model Hotel_Management_System.Models.ServiceType
@{
    ViewData["Title"] = "Delete Service Type";
}

<h2>Delete Service Type</h2>
<p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ServiceTypeId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

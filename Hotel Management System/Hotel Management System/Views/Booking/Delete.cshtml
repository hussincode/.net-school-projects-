@model Hotel_Management_System.Models.VM.BookingRecordsVM
@{
    ViewData["Title"] = "Delete Booking Record";
}

<h2>Delete Booking Record</h2>
<p>Are you sure you want to delete this booking record for Room <strong>@Model.RoomId</strong>?</p>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="BookingRecordId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@model Hotel_Management_System.Models.VM.BookingRecordsVM
@{
    ViewData["Title"] = "Edit Booking Record";
}

<h2>Edit Booking Record</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="BookingRecordId" />

    <div class="form-group">
        <label>Check-in Date</label>
        <input asp-for="CheckInDate" class="form-control" type="date" required />
    </div>

    <div class="form-group">
        <label>Check-out Date</label>
        <input asp-for="CheckOutDate" class="form-control" type="date" required />
    </div>

    <div class="form-group">
        <label>Room</label>
        <select asp-for="RoomId" class="form-control" asp-items="@(new SelectList(ViewBag.Rooms, "RoomId", "RoomNumber"))"></select>
    </div>

    <div class="form-group">
        <label>Service Type</label>
        <select asp-for="serviceTypesId" class="form-control" asp-items="@(new SelectList(ViewBag.ServiceTypes, "ServiceTypeId", "Name"))"></select>
    </div>

    <div class="form-group">
        <label>User</label>
        <select asp-for="userId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "UserId", "Name"))"></select>
    </div>

    <div class="form-group">
        <label>Notes</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

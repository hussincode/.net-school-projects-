@model Hotel_Management_System.Models.VM.RoomVM
@{
    ViewData["Title"] = "Edit Room";
}

<h2>Edit Room</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RoomId" />

    <div class="form-group">
        <label>Room Number</label>
        <input asp-for="RoomNumber" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Type</label>
        <input asp-for="Type" class="form-control" />
    </div>

    <div class="form-group">
        <label>Price Per Night</label>
        <input asp-for="PricePerNight" class="form-control" type="number" min="1" required />
    </div>

    <div class="form-group">
        <label>Status</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <div class="form-group">
        <label>User</label>
        <select asp-for="UserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "UserId", "Name"))"></select>
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

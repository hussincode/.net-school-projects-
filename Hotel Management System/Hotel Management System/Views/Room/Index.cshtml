@model IEnumerable<Hotel_Management_System.Models.Room>
@{
    ViewData["Title"] = "Rooms";
}

<h2>Rooms</h2>
<a asp-action="Create" class="btn btn-primary">Create New Room</a>

<table class="table">
    <thead>
        <tr>
            <th>Room Number</th>
            <th>Type</th>
            <th>Price Per Night</th>
            <th>Status</th>
            <th>Managed By</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var room in Model)
        {
            <tr>
                <td>@room.RoomNumber</td>
                <td>@room.Type</td>
                <td>@room.PricePerNight</td>
                <td>@room.Status</td>
                <td>@room.User?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@room.RoomId" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@room.RoomId" class="btn btn-danger"
                       onclick="return confirm('Are you sure you want to delete this room?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
